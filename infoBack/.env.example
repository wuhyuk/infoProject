# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=infodb
DB_USERNAME=root
DB_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Base64-encoded HS256 secret (최소 32바이트)
# 생성 예시: openssl rand -base64 32
JWT_SECRET=

# ─── OAuth2 - Google ──────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials 에서 발급
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OAuth2 - Naver ───────────────────────────────────────────────────────────
# https://developers.naver.com/apps/#/list 에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── Welfare API (data.go.kr) ─────────────────────────────────────────────────
# https://www.data.go.kr 에서 발급
WELFARE_API_KEY=

# ─── URL 설정 ─────────────────────────────────────────────────────────────────
# 프로덕션 배포 시 실제 도메인으로 변경
FRONTEND_URL=http://localhost:3000
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth/callback

# ─── 관리자 계정 (최초 실행 시 자동 생성) ──────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
